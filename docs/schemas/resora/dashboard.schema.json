{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resora.local/schemas/resora/1/dashboard.schema.json",
  "title": "RESORA dashboard (resource ids: manifest, layout)",
  "description": "Schema v1. DOCUMENTATION ONLY: no code validates against it in Phase 1. Fields marked x-phase have final semantics decided in that phase.",
  "$defs": {
    "manifest": {
      "type": "object",
      "required": ["schema_version", "format_version", "app_version", "mode", "created_utc", "document_id", "image_count"],
      "properties": {
        "schema_version": {"const": 1},
        "format_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "Container version, e.g. 1.0"},
        "app_version": {"type": "string"},
        "mode": {"enum": ["bundled", "linked"], "x-phase": 2},
        "created_utc": {"type": "string", "format": "date-time"},
        "document_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "image_count": {"type": "integer", "minimum": 0},
        "source": {
          "type": ["object", "null"],
          "x-phase": 2,
          "properties": {"kind": {"enum": ["folder", "files"]}, "root": {"type": ["string", "null"]}}
        },
        "resources": {
          "type": "array",
          "description": "Inventory summary",
          "x-phase": 2,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"}, "type": {"type": "string"}}
          }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["schema_version", "active_view"],
      "description": "Version 1: no omitted_roles (all Phase 5-6 files). Version 2: may contain omitted_roles; written only when a role is removed. The reader accepts 1 and 2; other values are refused (newer = 'written by a newer RESORA').",
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "active_view": {"enum": ["dashboard", "detailed"], "x-phase": 5},
        "visible_sections": {"type": ["array", "null"], "items": {"type": "string"}, "x-phase": 5},
        "omitted_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["largest", "smallest", "highest", "lowest"]},
          "description": "Requires schema_version 2. Roles whose image association the user removed (Remove from Dashboard). Optional; absent = none. A role listed here must have no widget. Null is invalid.",
          "x-phase": 6
        },
        "widgets": {
          "type": ["array", "null"],
          "x-phase": 5,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"type": "string"}, "row": {"type": "integer", "minimum": 0}, "col": {"type": "integer", "minimum": 0}, "span": {"type": "integer", "minimum": 1}}
          }
        }
      },
      "additionalProperties": true
    }
  }
}
